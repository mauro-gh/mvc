@page
@model mvc.Pages.Users
@{
    string aaa = "aa";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <div class="row">
        <div class="col-4">
            <label asp-for="Input.Email"></label>
            <input type="text" asp-for="Input.Email" class="form-control" placeholder="Email">
        </div>
        <div class="col-4">
            <label asp-for="Input.Role"></label>
            <select asp-for="Input.Role"  asp-items="@Html.GetEnumSelectList<Role>()" class="form-control">
            </select>
        </div>
        <div class="col-4">
            <label>Operazione</label>
            <button type="submit" class="btn btn-success" asp-route-inrole="@((int)Model.InRole)"  asp-page-handler="Assign">Assegna</button>
            <button type="submit" class="btn btn-danger" asp-route-inrole="@((int)Model.InRole)" asp-page-handler="Revoke">Revoca</button>
        </div>
    </div>
    <div class="row">
        <div class="col-12 mt-3" asp-validation-summary="All"></div>
    </div>
    
</form>


<ul class="nav nav-tabs mb-3">
    @foreach(SelectListItem ruoli in Html.GetEnumSelectList<Role>())
    {
        string activeClass = ruoli.Value == ((int)Model.InRole).ToString() ? "active" : string.Empty;
        <li class="nav-item">
            <a class="nav-link @activeClass" asp-route-inrole="@ruoli.Value"  aria-current="page" >@ruoli.Text</a>
        </li>

    }

</ul>

<h2>Elenco</h2>
@foreach (ApplicationUser user in Model.ListaUtenti)
{
    <div class="row">
            <div class="col-4">@user.FullName</div>
            <div class="col-4">@user.Email</div>
            <div class="col-4">@user.Id</div>
    </div>
    <hr>
    
}
<!-- In caso di not found -->
@if (Model.ListaUtenti.Count == 0)
{
    <p class="text-center text-muted">Nessun utente con questo ruolo</p>
}



@section Scripts
{
    <partial name="_Validation" />
}